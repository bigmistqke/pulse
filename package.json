{
  "name": "pulse",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./babel-plugin": {
      "types": "./dist/babel-plugin.d.ts",
      "import": "./dist/babel-plugin.js"
    },
    "./vite-jsx-plugin": {
      "types": "./dist/vite-jsx-plugin.d.ts",
      "import": "./dist/vite-jsx-plugin.js"
    }
  },
  "scripts": {
    "test": "pnpm canon check && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsdown --dts src/index.ts src/babel-plugin.ts src/vite-jsx-plugin.ts",
    "canon": "node .claude/skills/canon/cli.ts"
  },
  "canon": {
    "documents": [
      "CANON.md"
    ],
    "suites": "test",
    "sources": [
      "src",
      "test"
    ],
    "references": [],
    "command": "pnpm canon"
  },
  "dependencies": {
    "r3": "github:bigmistqke/r3#411cd5d451ed00c419d00f9f26b15c6a4731ab0c"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/helper-module-imports": "^8.0.0",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@babel/types": "^8.0.4",
    "@vitest/browser": "^3.2.4",
    "playwright": "^1.60.0",
    "tsdown": "^0.11.1",
    "typescript": "^5.8.3",
    "vite": "^6.4.2",
    "vitest": "^3.1.3"
  }
}
